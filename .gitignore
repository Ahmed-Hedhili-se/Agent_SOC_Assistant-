# Application data & logs (keep the directory structure and the bundled
# sample alerts used by run_pipeline.py and the test suite)
/soc-assistant/data/alerts/*
!/soc-assistant/data/alerts/.gitkeep
!/soc-assistant/data/alerts/sample_alerts.json
/soc-assistant/data/logs/*
!/soc-assistant/data/logs/.gitkeep

